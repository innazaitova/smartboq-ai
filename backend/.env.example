# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/quantibot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantibot
DB_USER=postgres
DB_PASSWORD=yourpassword

# API Keys
OPENAI_API_KEY=sk-proj-your-openai-key-here
GOOGLE_CLOUD_VISION_KEY=your-gcp-key-here

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 Storage
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=quantibot-drawings
AWS_REGION=us-east-1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@quantibot.ai

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Application Settings
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://quantibot.ai

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,dwg,dxf,png,jpg,jpeg

# AI Processing
MAX_CONCURRENT_ANALYSES=5
PROCESSING_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/quantibot.log

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
ENABLE_PDF_GENERATION=true
ENABLE_API_ACCESS=true
ENABLE_WHITE_LABEL=false
