# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/quantibot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantibot
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Keys (Get from OpenAI dashboard)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Authentication (Generate a secure random string)
JWT_SECRET_KEY=generate-a-secure-random-string-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 Storage (Optional - for production file storage)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=quantibot-drawings
AWS_REGION=us-east-1

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@quantibot.ai

# Application URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development
