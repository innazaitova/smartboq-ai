# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/quantibot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantibot
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Keys (Get from OpenAI dashboard)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Authentication (Generate a secure random string)
JWT_SECRET_KEY=generate-a-secure-random-string-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email Service (SendGrid - Get API key from sendgrid.com)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@smartboq.ai
FROM_NAME=SmartBOQ AI

# AWS S3 Storage (Optional - for production file storage)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=quantibot-drawings
AWS_REGION=us-east-1

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@smartboq.ai
FROM_NAME=SmartBOQ AI

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://smartboq-ai.vercel.app

# Application URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development
